#!/bin/sh

# PROVIDE: postfix_dane_policy
# REQUIRE: LOGIN
# BEFORE: postfix
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable postfix-dane-policy:
#
# postfix_dane_policy_enable (bool):	Set to YES to enable.
#					Default: NO
# postfix_dane_policy_user (str):	Run as this user.
#					Default: nobody
# postfix_dane_policy_flags (str):	Arguments for postfix-dane-policy.
#					Default: --listen 127.0.0.1 --port 8462 --dns 127.0.0.1

. /etc/rc.subr

name=postfix_dane_policy
rcvar=postfix_dane_policy_enable

load_rc_config $name

: ${postfix_dane_policy_enable:="NO"}
: ${postfix_dane_policy_user:="nobody"}
: ${postfix_dane_policy_flags:="--listen 127.0.0.1 --port 8462 --dns 127.0.0.1"}

pidfile="/var/run/${name}.pid"
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
command_args="-f -r -P ${pidfile} -u ${postfix_dane_policy_user} -T postfix-dane-policy %%PREFIX%%/bin/postfix-dane-policy"

run_rc_command "$1"
